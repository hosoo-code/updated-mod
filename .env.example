# ============================================================
# ARHAT MODERATOR — Environment Variables Template
# ------------------------------------------------------------
# Энэ файлыг `.env.local` болгон хуулаад (`cp .env.example .env.local`)
# жинхэнэ утгуудаа бөглөнө үү. .env.local нь .gitignore-д орсон тул
# commit хийгдэхгүй, secret хамгаалагдана.
#
# Supabase Project Settings → API  хэсгээс утгуудаа олно уу.
# ============================================================

# ------------------------------------------------------------
# SUPABASE (ЗААВАЛ — апп энэгүйгээр demo горимд л ажиллана)
# ------------------------------------------------------------

# Supabase Project URL (Project Settings → API → Project URL)
# Жишээ: https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anon/public key (Project Settings → API → anon public)
# Client болон server-т хэрэглэгдэнэ. safe нь public.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase Service Role key (Project Settings → API → service_role)
# !!! ЭНЭ НУУЦ — зөвхөн SERVER дээр ашиглагдана. Client bundle-д БҮҮ оруул.
# Admin, dashboard хэсгүүд ЭНЭГҮЙГЭЭР ажиллахгүй.
SUPABASE_SERVICE_ROLE_KEY=

# Production-д demo mode-г унтраах (ЗӨВЛӨМЖ: production дээр ALWAYS true)
# Хэрэв true бол Supabase тохируулаагүй ч demo горим идэвхжихгүй.
DISABLE_DEMO_MODE=true

# ------------------------------------------------------------
# R2 / Cloudflare Storage (ЗУРАГ UPLOAD АШИГЛАХАД ЗААВАЛ)
# ------------------------------------------------------------
# Cloudflare Dashboard → R2 → Bucket, Account API токен

# Cloudflare Account ID (Cloudflare Dashboard → Хуудасны URL-ээс)
R2_ACCOUNT_ID=

# R2 Access Key ID (R2 → Manage API Tokens → токен үүсгэх)
R2_ACCESS_KEY_ID=

# R2 Secret Access Key (R2 → Manage API Tokens → токен үүсгэх)
R2_SECRET_ACCESS_KEY=

# R2 Bucket нэр (R2 → Buckets)
R2_BUCKET_NAME=

# R2 Endpoint (ихэвчлэн хоосон үлдээгээрэй — автоматаар тооцоолно)
# Жишээ: https://<ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ENDPOINT=

# ------------------------------------------------------------
# App URL (сонголттой)
# ------------------------------------------------------------

# Деploy хийсэн app-ийн бүрэн URL (link, redirect зарим функцэд)
# Жишээ: https://arhat.vercel.app
APP_URL=

# ------------------------------------------------------------
# CRON (Vercel Cron / хавсралт cleanup-д ЗААВАЛ)
# ------------------------------------------------------------

# Cron endpoint-ийг хамгаалах нууц үг (дурын урт random string)
# Vercel Cron-ийн Authorization Bearer header-тэй таарах ёстой
CRON_SECRET=

# ------------------------------------------------------------
# ДЕМО / ГАДААД API (сонголттой)
# ------------------------------------------------------------

# Demo session-ийн signature нууц (зөвхөн demo mode-д)
# Secure random string ашиглана уу: openssl rand -hex 32
DEMO_SIGN_SECRET=

# OCR / Төрсний гэрчилгээ уншилтын API key (ашиглаж байгаа бол)
# Хоосон бол OCR ажиллахгүй — submit нь 'pending' буцаана (fail-open)
DOC_READER_API_KEY=

# VPN / IP үнэлгээний API key (ашиглаж байгаа бол)
# Хоосон бол VPN шалгалт идэвхжихгүй
IP_REPUTATION_API_KEY=
